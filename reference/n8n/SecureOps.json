        "jsCode": "const body = $json.body ?? $json;\n\nconst request = body.request ?? {};\nconst userId = body.userId ?? \"test-user\";\n\nconst intent = request.intent;\nconst risk = request.risk;\nconst requiresApproval = request.requires_approval ?? false;\n\nconst allowedIntents = [\"SEARCH_DOCUMENT\"];\n\nconst allowed =\n  allowedIntents.includes(intent) &&\n  risk === \"LOW\" &&\n  requiresApproval === false;\n\nif (!intent) {\n  throw new Error(\"Invalid request: intent is required\");\n}\n\nif (![\"LOW\", \"MEDIUM\", \"HIGH\"].includes(risk)) {\n  throw new Error(\"Invalid request: risk must be LOW, MEDIUM or HIGH\");\n}\n\nreturn [\n  {\n    json: {\n      userId,\n      request: JSON.stringify(request),\n      intent,\n      risk,\n      requiresApproval,\n      allowed,\n      validation: \"PASSED\"\n    }\n  }\n];"
      },
